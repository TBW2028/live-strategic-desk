    "escalate_on_hurricane": true
  },
  "gdacs": {
    "include_event_types": ["EQ", "TC", "FL", "VO", "DR"],
    "exclude_event_types": ["WF"],
    "min_alert_level": "Orange",
    "store_green": false,
    "store_forest_fire": false
  },
  "flood": {
    "alert_on_official_warning": true
  },
  "health": {
    "official_notices_only": true,
    "alert_on_who_don": true
  }
