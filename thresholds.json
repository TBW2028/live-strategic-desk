{
  "version": 2,
  "earthquake": {
    "list_min_mag": 4.5,
    "watch_mag": 5.5,
    "alert_mag": 6.0,
    "escalate_mag": 7.0,
    "sequence_alert_mag": 5.5,
    "sequence_escalate_mag": 6.5
  },
  "volcano": {
    "alert_levels": ["Watch", "Warning", "Orange", "Red"],
    "watch_levels": ["Advisory", "Yellow"]
  },
  "cyclone": {
